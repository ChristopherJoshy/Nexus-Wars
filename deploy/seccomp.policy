ALLOW {
  read, readv, write, writev, pread64, pwrite64,
  close, dup, dup2, dup3,
  open, openat,
  newfstatat, statx, stat, lstat, fstat,
  access, faccessat, faccessat2,
  lseek,
  mmap, munmap, mprotect, madvise, mremap, brk,
  ioctl, fcntl, fadvise64,
  rt_sigaction, rt_sigprocmask, rt_sigreturn, sigaltstack,
  sched_yield, sched_getaffinity, sched_setaffinity, getcpu,
  getpid, gettid, getppid,
  getuid, geteuid, getgid, getegid, getgroups,
  getcwd, readlink, readlinkat,
  set_tid_address, set_robust_list, get_robust_list,
  futex,
  clone, clone3,
  execve, wait4,
  pipe, pipe2,
  poll, ppoll, select, pselect6,
  epoll_create1, epoll_ctl, epoll_wait, epoll_pwait,
  kill, tkill, tgkill,
  exit, exit_group,
  arch_prctl,
  prlimit64, prctl, capget, umask, getdents64,
  gettimeofday, clock_gettime, clock_getres, time, times, getrusage,
  getrandom, membarrier,
  rseq,
  socket, socketpair, connect, accept, accept4, bind, listen,
  sendto, recvfrom, sendmsg, recvmsg,
  getsockopt, setsockopt, getsockname, getpeername, shutdown
}

DEFAULT KILL_PROCESS
